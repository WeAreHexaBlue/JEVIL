# App
ORIGIN="http://localhost:5173"

# Better Auth — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=""

# OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Provider credential encryption (optional until connections ship)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""
# Rotation map; takes precedence over ENCRYPTION_KEY. New writes use the highest version.
# ENCRYPTION_KEYS='{"1":"<base64 key>","2":"<base64 key>"}'
ENCRYPTION_KEYS=""

# Email (optional; verification and reset links are printed in dev when unset)
RESEND_API_KEY=""
EMAIL_FROM="JEVIL <hello@example.com>"

# Cloudflare D1 (only needed for remote drizzle-kit commands)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_DATABASE_ID=""
CLOUDFLARE_D1_TOKEN=""
