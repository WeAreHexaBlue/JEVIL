{
    "extends": "$app/tsconfig",
    "compilerOptions": {
        "strict": true,
        "checkJs": false,
        "paths": {
            "#lib": ["./src/lib/index.ts"],
            "#lib/*": ["./src/lib/*"]
        },
        "types": ["$app/types", "./worker-configuration.d.ts", "node"]
    },
    "include": [
        "src",
        "scripts",
        "vite.config.ts",
        "prettier.config.js",
        "eslint.config.js",
        "drizzle.config.ts"
    ],
    "exclude": ["src/lib/paraglide"]
}
