{
    "name": "jevil",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
        "prepare": "svelte-kit sync && wrangler types || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "gen": "wrangler types",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "prettier --check . && eslint .",
        "format": "prettier --write .",
        "db:generate": "drizzle-kit generate",
        "db:migrate:local": "wrangler d1 migrations apply jevil --local",
        "db:migrate:remote": "wrangler d1 migrations apply jevil --remote",
        "db:studio": "drizzle-kit studio",
        "auth:schema": "auth generate --config src/lib/server/auth.cli.ts --output src/lib/server/db/auth.schema.ts --yes && prettier --write src/lib/server/db/auth.schema.ts"
    },
    "dependencies": {
        "@fontsource-variable/bricolage-grotesque": "^5.2.10",
        "@fontsource-variable/instrument-sans": "^5.2.8",
        "@fontsource-variable/jetbrains-mono": "^5.2.8",
        "better-auth": "^1.6.24",
        "drizzle-orm": "^0.45.2",
        "zod": "^4.1.12"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@inlang/paraglide-js": "^2.18.2",
        "@sveltejs/adapter-cloudflare": "^8.0.0",
        "@sveltejs/kit": "^3.0.0",
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "@tailwindcss/vite": "^4.3.0",
        "@types/node": "^24",
        "auth": "^1.6.24",
        "drizzle-kit": "^0.31.10",
        "eslint": "^10.4.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.19.0",
        "globals": "^17.6.0",
        "prettier": "^3.8.3",
        "prettier-plugin-svelte": "^4.1.0",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "svelte": "^5.57.2",
        "svelte-check": "^4.6.0",
        "tailwindcss": "^4.3.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.60.1",
        "vite": "^8.3.0",
        "vitest": "^4.1.8",
        "wrangler": "^4.97.0"
    },
    "imports": {
        "#lib": "./src/lib/index.js",
        "#lib/*": "./src/lib/*"
    }
}
